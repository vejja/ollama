From a2855b0ba7b6e2cae6b13fe57c7358e5fe956962 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?S=C3=A9bastien=20Raffray?= <sraffray@yahoo.fr>
Date: Sat, 29 Aug 2026 17:39:21 +0200
Subject: [PATCH] Add global-scale NVFP4 quantized matmul binding

---
 mlx/c/ops.cpp | 35 +++++++++++++++++++++++++++++++++++
 mlx/c/ops.h   | 12 ++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/mlx/c/ops.cpp b/mlx/c/ops.cpp
index 40b5a0c..e18d74a 100644
--- a/mlx/c/ops.cpp
+++ b/mlx/c/ops.cpp
@@ -2615,6 +2615,41 @@ extern "C" int mlx_quantized_matmul(
   }
   return 0;
 }
+extern "C" int mlx_quantized_matmul_global_scale(
+    mlx_array* res,
+    const mlx_array x,
+    const mlx_array w,
+    const mlx_array scales,
+    const mlx_array biases /* may be null */,
+    bool transpose,
+    mlx_optional_int group_size,
+    mlx_optional_int bits,
+    const char* mode,
+    const mlx_array global_scale,
+    const mlx_stream s) {
+  try {
+    mlx_array_set_(
+        *res,
+        mlx::core::quantized_matmul_global_scale(
+            mlx_array_get_(x),
+            mlx_array_get_(w),
+            mlx_array_get_(scales),
+            (biases.ctx ? std::make_optional(mlx_array_get_(biases))
+                        : std::nullopt),
+            transpose,
+            (group_size.has_value ? std::make_optional<int>(group_size.value)
+                                  : std::nullopt),
+            (bits.has_value ? std::make_optional<int>(bits.value)
+                            : std::nullopt),
+            std::string(mode),
+            mlx_array_get_(global_scale),
+            mlx_stream_get_(s)));
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
 extern "C" int
 mlx_radians(mlx_array* res, const mlx_array a, const mlx_stream s) {
   try {
diff --git a/mlx/c/ops.h b/mlx/c/ops.h
index 44fc09c..cb5bf07 100644
--- a/mlx/c/ops.h
+++ b/mlx/c/ops.h
@@ -817,6 +817,18 @@ int mlx_quantized_matmul(
     mlx_optional_int bits,
     const char* mode,
     const mlx_stream s);
+int mlx_quantized_matmul_global_scale(
+    mlx_array* res,
+    const mlx_array x,
+    const mlx_array w,
+    const mlx_array scales,
+    const mlx_array biases /* may be null */,
+    bool transpose,
+    mlx_optional_int group_size,
+    mlx_optional_int bits,
+    const char* mode,
+    const mlx_array global_scale,
+    const mlx_stream s);
 int mlx_radians(mlx_array* res, const mlx_array a, const mlx_stream s);
 int mlx_real(mlx_array* res, const mlx_array a, const mlx_stream s);
 int mlx_reciprocal(mlx_array* res, const mlx_array a, const mlx_stream s);
